      "html": "<section class=\"ds-card\"><header>Recent transactions</header><div class=\"ds-card-b\">Groceries <span>$42.10</span></div></section>",
      "css": ".ds-card{width:320px;background:var(--card);color:var(--card-foreground);border:1px solid var(--border);border-radius:11.2px;overflow:hidden;font:400 14px Geist,ui-sans-serif,system-ui,sans-serif}.ds-card header{padding:12px 20px;border-bottom:1px solid var(--border);font-weight:500;font-size:16px}.ds-card-b{display:flex;justify-content:space-between;padding:16px 20px}.ds-card-b span{font-weight:500;font-variant-numeric:tabular-nums lining-nums}"
    },
    {
      "name": "Summary Strip",
      "kind": "custom",
      "refersTo": "summary-cell",
      "description": "Four hairline-divided stat cells on one surface.",
      "html": "<dl class=\"ds-strip\"><div><dt>Spent</dt><dd>$1,284.50</dd></div><div><dt>Budgeted</dt><dd>$2,000.00</dd></div><div><dt>Over budget</dt><dd class=\"over\">$84.50</dd></div><div><dt>Month</dt><dd>Day 18</dd><dd class=\"d\">of 30 · 12 left</dd></div></dl>",
      "css": ".ds-strip{display:grid;grid-template-columns:repeat(4,1fr);gap:1px;margin:0;background:var(--border);border:1px solid var(--border);border-radius:11.2px;overflow:hidden;font-family:Geist,ui-sans-serif,system-ui,sans-serif}.ds-strip>div{background:var(--card);padding:20px;display:flex;flex-direction:column;gap:4px}.ds-strip dt{color:var(--muted-foreground);font-size:14px}.ds-strip dd{margin:0;font-size:24px;font-weight:600;letter-spacing:-0.025em;color:var(--foreground)}.ds-strip dd.over{color:var(--destructive)}.ds-strip dd.d{font-size:12px;font-weight:400;letter-spacing:0;color:var(--muted-foreground);font-variant-numeric:tabular-nums}"
    },
    {
      "name": "Budget Pace Bar",
      "kind": "custom",
      "refersTo": "pace-bar-track",
      "description": "Signature: fill coloured by state, with the indigo pace line at today's point in the month.",
      "html": "<div class=\"ds-pace\"><div class=\"row\"><span class=\"dot\" style=\"background:var(--cat-food,#eb6834)\"></span><b>Food</b><span class=\"amt\"><strong>$212</strong> / $300</span></div><div class=\"bar\" role=\"meter\" aria-label=\"Food\" aria-valuenow=\"212\" aria-valuemin=\"0\" aria-valuemax=\"300\"><div class=\"track\"><div class=\"fill\" style=\"width:70.6%\"></div></div><div class=\"line\" style=\"left:60%\"></div></div><p class=\"st\">Ahead of pace · $88 left</p></div>",
      "css": ".ds-pace{width:360px;font:400 14px Geist,ui-sans-serif,system-ui,sans-serif;color:var(--foreground);display:flex;flex-direction:column;gap:10px}.ds-pace .row{display:flex;align-items:center;gap:12px}.ds-pace .dot{width:8px;height:8px;border-radius:9999px}.ds-pace b{flex:1;font-weight:500}.ds-pace .amt{color:var(--muted-foreground);font-variant-numeric:tabular-nums}.ds-pace .amt strong{color:var(--foreground);font-weight:500}.ds-pace .bar{position:relative;height:8px}.ds-pace .track{position:absolute;inset:0;background:var(--muted);border-radius:9999px;overflow:hidden}.ds-pace .fill{height:100%;border-radius:9999px;background:var(--warning);transition:width .5s ease-out}.ds-pace .line{position:absolute;top:-4px;bottom:-4px;width:2px;transform:translateX(-50%);background:var(--pace);border-radius:9999px;box-shadow:0 0 0 2px var(--background)}.ds-pace .st{margin:0;font-size:12px;font-weight:500;color:var(--warning-foreground);font-variant-numeric:tabular-nums}"
