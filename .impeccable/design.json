    {
      "name": "Primary Button",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "The single filled action per view.",
      "html": "<button class=\"ds-btn ds-btn-primary\">Add expense</button>",
      "css": ".ds-btn{display:inline-flex;align-items:center;gap:6px;height:32px;padding:0 10px;border-radius:8px;border:1px solid transparent;font:500 14px/1 Geist,ui-sans-serif,system-ui,sans-serif;cursor:pointer;transition:background-color .15s,box-shadow .15s,transform .05s;outline:none}.ds-btn-primary{background:var(--primary);color:var(--primary-foreground)}.ds-btn-primary:hover{background:color-mix(in oklch,var(--primary) 80%,transparent)}.ds-btn-primary:focus-visible{border-color:var(--ring);box-shadow: 0 0 0 3px color-mix(in oklch, var(--ring) 50%, transparent);}.ds-btn-primary:active{transform:translateY(1px)}"
    },
    {
      "name": "Outline Button",
      "kind": "button",
      "refersTo": "button-outline",
      "description": "Secondary action beside a primary, e.g. Sign in.",
      "html": "<button class=\"ds-btn-o\">Sign in</button>",
      "css": ".ds-btn-o{display:inline-flex;align-items:center;height:32px;padding:0 10px;border-radius:8px;border:1px solid var(--border);background:var(--background);color:var(--foreground);font:500 14px/1 Geist,ui-sans-serif,system-ui,sans-serif;cursor:pointer;transition:background-color .15s;outline:none}.ds-btn-o:hover{background:var(--muted)}.ds-btn-o:focus-visible{border-color:var(--ring);box-shadow: 0 0 0 3px color-mix(in oklch, var(--ring) 50%, transparent);}.ds-btn-o:active{transform:translateY(1px)}"
    },
    {
      "name": "Ghost Button",
