# Copy to .env.local and fill in.

# MongoDB connection (docker compose up -d gives you this one)
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB=fundflow

# Secret used to sign session cookies. Generate one with:
#   openssl rand -base64 32
AUTH_SECRET=

# Optional: enables the AI assistant. Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Optional: override the Gemini model id (default: gemini-4-hydrogen)
GEMINI_MODEL=
